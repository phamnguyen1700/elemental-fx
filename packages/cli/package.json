{
  "name": "elemental-fx",
  "version": "0.1.2",
  "description": "CLI for adding elemental-fx effect layers to consumer projects.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamnguyen1700/elemental-fx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/phamnguyen1700/elemental-fx#readme",
  "bugs": {
    "url": "https://github.com/phamnguyen1700/elemental-fx/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "elemental-fx": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
